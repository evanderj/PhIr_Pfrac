pvalue_table[1,5] <- p_value_ext(TP_na_site, pt=1)
rP_check <- soils_PSI %>% dplyr::select(SampleEvent, Area, SiteName, PlotNumber,PfracRP, PfracTotP)
rP_check$Perc <- rP_check$PfracRP/rP_check$PfracTotP*100
